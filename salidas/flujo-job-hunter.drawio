<mxfile host="app.diagrams.net">
  <diagram name="Flujo Job Hunter">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Job Hunter — Flujo de punta a punta (Laravel + Inertia/Vue)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Bandas / rótulos de etapa -->
        <mxCell id="lb1" value="1 · Ingesta de vacantes" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="20" as="geometry" /></mxCell>
        <mxCell id="lb2" value="2 · Análisis con IA (multi-proveedor)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="320" height="20" as="geometry" /></mxCell>
        <mxCell id="lb3" value="3 · Marketplace, seguimiento y publicación" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="320" height="20" as="geometry" /></mxCell>
        <mxCell id="lb4" value="4 · Perfil / CV del candidato" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="320" height="20" as="geometry" /></mxCell>

        <!-- Actor -->
        <mxCell id="user" value="Usuario&#10;(Inertia/Vue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="120" height="50" as="geometry" /></mxCell>

        <!-- Fuentes externas -->
        <mxCell id="sources" value="Fuentes externas&#10;InfoJobs · JSearch · LaraJobs RSS&#10;(JobSourceInterface)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="200" height="70" as="geometry" /></mxCell>

        <!-- Ingesta -->
        <mxCell id="fetch" value="POST /jobs/fetch&#10;JobController@fetch&#10;→ Fetchers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="230" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="job" value="Job&#10;(Model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="235" width="90" height="50" as="geometry" /></mxCell>

        <!-- Análisis IA -->
        <mxCell id="analyze" value="POST /jobs/{job}/analyze&#10;JobAnalyzer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="factory" value="AIProviderFactory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="170" height="40" as="geometry" /></mxCell>
        <mxCell id="providers" value="Proveedores IA&#10;Gemini · OpenRouter · Claude CLI&#10;(AIProvider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="400" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="settings" value="AiSetting +&#10;AiModelCatalog&#10;(GET/PUT /ai/settings)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="scored" value="Job analizado&#10;score + JobStatus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="235" width="150" height="50" as="geometry" /></mxCell>

        <!-- Seguimiento y publicación -->
        <mxCell id="marketplace" value="GET /marketplace&#10;analyze-pending · track-bulk&#10;(MarketplaceController)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="track" value="POST /marketplace/{job}/track&#10;→ TrackedJob (Model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1030" y="210" width="220" height="50" as="geometry" /></mxCell>
