        <mxCell id="review" value="ProfileReviewer&#10;POST /profile/{p}/review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="475" width="180" height="45" as="geometry" /></mxCell>
        <mxCell id="tailor" value="CvTailorer&#10;POST /profile/tailor (+confirm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="530" width="180" height="45" as="geometry" /></mxCell>
