APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI provider selection ---
AI_PROVIDER=claude_cli          # claude_cli | gemini | openrouter

# --- Claude CLI (default, uses your local session, $0) ---
CLAUDE_CLI_BINARY=claude        # path or binary name in your PATH
CLAUDE_CLI_MODEL=               # optional; empty = CLI default model
# On macOS the CLI session lives in the login Keychain, which PHP-FPM (a root
# LaunchDaemon) cannot read: every web request answers "Not logged in".
# Generate a long-lived token with `claude setup-token` and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Extended thinking never reaches the parsed "result" field but is billed and
# timed like any other output token. 0 disables it; leave empty for CLI default.
CLAUDE_CLI_MAX_THINKING_TOKENS=0

# --- Gemini (free fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenRouter (flexible fallback) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=               # e.g. a model with a :free suffix

# --- Sources ---
RAPIDAPI_KEY=
INFOJOBS_ENABLED=false
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
JOB_SEARCH_QUERIES="php developer remote,laravel developer,full stack developer colombia"
JOB_SEARCH_COUNTRY=co

# How many `queue:work` processes `composer dev` runs for the "analysis" queue.
# Each is mostly idle time waiting on the AI provider, so this is the real lever
# on how many job listings get analyzed per minute.
JOBHUNTER_ANALYSIS_WORKERS=4

# --- Notion (backup) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- General ---
MATCH_SCORE_ALERT_THRESHOLD=80
MIN_MATCH_TO_PUBLISH=75          # threshold to publish to Notion; local storage keeps every job
ACTIVE_PROFILE=default           # active profile variant slug used for job matching

# --- Owner (single-user login, created by `php artisan db:seed`) ---
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=password
